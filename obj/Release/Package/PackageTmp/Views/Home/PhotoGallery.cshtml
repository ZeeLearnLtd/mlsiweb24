
@{
    ViewBag.Title = "PhotoGallery";
}

<style>
    .image-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .gallery-thumb {
        width: 23%; /* roughly 4 per row with small gaps */
        height: auto;
        border-radius: 4px;
    }
    .loader {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #fff url('https://i.gifer.com/ZZ5H.gif') no-repeat center center;
        /*        height:500px;*/
        z-index: 10;
    }

    @@media screen and (max-width: 600px) {
    .ul_list {
        height: auto !important;
        overflow-y: scroll !important;
        overflow-x: hidden !important;
    }
        .nav-tabs-left .nav-tabs {
            overflow-x:scroll !important;
        }
        }
</style>
<div id="" class="" ng-cloak id="PhotoGallery" ng-controller="NewsAndEventsCtrl" ng-init="Type='PhotoGallery';GetNewsAndEvents()">
    @*Childrens Day Celebration,Investiture Ceremony,Halloween Celebration,First Day of School*@
    <div class="nav-tabs-left">
        <ul class="nav nav-tabs ul_list">
            <li class="nav-item" ng-repeat="category in categoryNames">
                <a class="nav-link waves-effect" ng-class="{'active': selectedCategory === category}" data-toggle="tab" ng-click="oncategoryselection(category)">{{category}}</a>
            </li>
        </ul>

        <div class="nav-tabs-left-container">
            <div class="loader" ng-if="loading"></div>
            <div class="tab-content Gallery">
                @*<div class="row g-3">
        <div class="col-6 col-md-4 col-lg-3" ng-repeat="photo in filteredData">*@
                @*<div ng-if="!photo.FromDate">
            <div ng-repeat="dat in photo.allfiles">
                <a href="{{dat.url}}" data-fancybox="{{photo.categoryName}}" data-transition-effect="tube">
                    <img ng-src="{{dat.url}}" class="img-fluid rounded shadow-sm mb-2" alt="" />
                </a>
            </div>
        </div>*@
                @*!groupedFilesByYear &&*@
                <div ng-if="!groupedFilesByYear">
                    <div class="row g-3">
                        <div class="col-6 col-md-4 col-lg-3" ng-repeat="photo in filteredData">
                            <div ng-repeat="dat in photo.allfiles">
                                <a href="{{dat.url}}" data-fancybox="{{photo.categoryName}}" data-transition-effect="tube">
                                    <img ng-src="{{dat.url}}" class="img-fluid rounded shadow-sm mb-2" alt="" />
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div ng-if="groupedFilesByYear">
            <div ng-repeat="yearGroup in groupedFilesByYear">
                <h4 class="text-center" style="text-decoration:underline">{{yearGroup.yearLabel}}</h4>
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg-3" ng-repeat="dat in yearGroup.files">
                        <a href="{{dat.url}}" data-fancybox="{{dat.categoryName}}" data-transition-effect="tube">
                            <img ng-src="{{dat.url}}" class="img-fluid rounded shadow-sm mb-2" alt="" />
                        </a>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3"
                 ng-if="visibleCount < allFilesFlat.length">
                <button class="btn btn-primary" ng-click="loadMore()">
                    Load More
                </button>
            </div>
        </div>
                @*<div ng-repeat="(year, files) in groupedFilesByYear">
                    <h4 class="text-center" style="text-decoration:underline">{{year}}</h4>
                    <div class="row g-3">
                        <div class="col-6 col-md-4 col-lg-3" ng-repeat="file in visibleFiles" ng-if="file.year == year">
