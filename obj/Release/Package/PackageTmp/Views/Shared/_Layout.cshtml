    @Styles.Render("~/Content/Styles")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        .popup-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }

        #back-top {
            position: fixed;
            bottom: 12px;
            left: 20px !important;
            z-index: 1;
            cursor: pointer;
            background-color: #223871;
            color: #fff;
            width: 55px;
            height: 55px;
        }

        .popup {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #fff;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
        }

            .popup img {
                max-width: 85%;
                height: auto;
                display: block;
                margin: 0 auto;
            }

        .close-btn {
            position: absolute;
            right: 0;
            background: none;
            border: none;
            font-size: 30px;
            top: 0;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .zsiq_custommain siq_bR {
            width: 80px !important;
            height: 80px !important;
        }

        .zsiq_custommain img {
            max-height: 80px !important;
            max-width: 80px !important;
            height: auto;
            width: auto;
        }

        @@media only screen and (max-width: 600px) {
            .popup img {
                max-width: 100%;
                height: auto;
                display: block;
                margin: 0 auto;
            }
        }
    </style>
