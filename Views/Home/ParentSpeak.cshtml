
@{
    ViewBag.Title = "ParentSpeak";
}
<script type="text/javascript"
        src="https://d3mkw6s8thqya7.cloudfront.net/integration-plugin.js"
        id="aisensy-wa-widget"
        widget-id="aaau9i">
</script>

<section class="" ng-cloak id="parentspeak" ng-controller="NewsAndEventsCtrl" ng-init="Type='Parent Testimonial';GetNewsAndEvents()">
    <div class="container" id="ParentSpeak">
        <div class="pageheading">
            <h1>
                Parent Testimonials
            </h1>
        </div>
        <div class="row">

            <div class="col-md-6" ng-repeat="video in NewsAndEventsData">
                <a data-fancybox="Videogallery"
                   href="https://www.youtube.com/embed/{{ video.LinkUrl }}?autoplay=1&rel=0"
                   data-transition-effect="tube">
                    <i class="fa fa-play"></i>
                    <img ng-src="https://img.youtube.com/vi/{{ video.LinkUrl }}/hqdefault.jpg"
                         alt="{{ video.Title }}" />
                </a>
            </div>
        </div>
    </div>
</section>


<style type="text/css">
    video {
        width: 100%;
    }
</style>