
@{
  ViewBag.Title = "CASGallery";
}
<!--<section class="ComingSoon">-->
  @*<h2>Coming Soon...</h2>*@
<!--</section>-->
<style>
    .image-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .gallery-thumb {
        width: 23%; /* roughly 4 per row with small gaps */
        height: auto;
        border-radius: 4px;
    }

    .loader {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #fff url('https://i.gifer.com/ZZ5H.gif') no-repeat center center;
        /*        height:500px;*/
        z-index: 10;
    }
</style>
<div id="" class="" ng-cloak id="CASGallery" ng-controller="NewsAndEventsCtrl" ng-init="Type='CASGallery';GetNewsAndEvents()">
    <div class="nav-tabs-left">
        <ul class="nav nav-tabs">
            <li class="nav-item" ng-repeat="category in categoryNames">
                <a class="nav-link waves-effect" ng-class="{'active': selectedCategory === category}" data-toggle="tab" ng-click="oncategoryselection(category)">{{category}}</a>
            </li>
        </ul>
        <div class="loader" ng-if="loading"></div>
        <div class="nav-tabs-left-container">
            <div class="tab-content Gallery">
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg-3" ng-repeat="photo in filteredData">
                        <div ng-repeat="dat in photo.allfiles">
                            <a href="{{dat.url}}" data-fancybox="{{photo.categoryName}}" data-transition-effect="tube">
                                <img ng-src="{{dat.url}}" class="img-fluid rounded shadow-sm mb-2" alt="" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

