        <div class="video-wrapper">
            <!-- Loader shown initially -->
            <div id="video-loader" class="loader"></div>
            <!-- Video -->
            <video id="myVideo" autoplay muted loop controls>
                <source src="https://s3.ap-south-1.amazonaws.com/content.pentemind.com/Web+Banner+Graduation+day.mp4" type="video/mp4" />
                Your browser does not support the video tag.
            </video>
        </div>

        <div class="caption">
            <div class="container">
                <p class="video_text_content" data-animation-in="fadeInUp">
                    Mount Litera School International (MLSI) is a future-ready IB Continuum School
                    authorized by the International Baccalaureate Organization to offer its Primary Years
                    Programme (PYP), Middle Years Programme (MYP) and the Diploma Programme
                    (DP). Located centrally in Bandra Kurla Complex in Mumbai, it is one of the very few
                    IB Continuum schools in Mumbai.
                </p>
                @*<div class="btns" data-animation-in="fadeInUp">
                    <a href="@Url.Action("Vision", "Home")" class="btn btn-lg btn-first">Read more</a>
                </div>*@
            </div>
        </div>
