<style>
    .video-wrapper {
        position: relative;
        width: 100%;
        max-width: 100%;
    }

    .loader {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: #fff url('https://i.gifer.com/ZZ5H.gif') no-repeat center center;
/*        height:500px;*/
        z-index: 10;
    }

    video {
        width: 100%;
        height: auto;
        display: block;
    }
    .video_content_img {
        height: 450px;
    }
    .aboutus .abtusimg:nth-child(1) {
        margin-right: 0px !important;
    }

    @@media only screen and (max-width: 600px) {
    .video_content_img {
        height: auto !important;
    }
                       }
